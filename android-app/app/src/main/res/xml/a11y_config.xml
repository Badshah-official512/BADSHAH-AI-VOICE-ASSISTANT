<?xml version="1.0" encoding="utf-8"?>
<!--
  v7.8.2 Fault-2 upgrade: FULL phone control ke liye mukammal config.
  - Event types: window state/content ke ilawa clicks, scrolls, focus, text
    changes, notifications aur windows-changed bhi — taake service har app ki
    tabdeeli se waqif rahe.
  - Flags: flagRetrieveInteractiveWindows (saari windows parhna — dialogs,
    popups, doosri apps) + flagReportViewIds (elements ki pakki pehchan) +
    flagIncludeNotImportantViews (chhote controls bhi nazar ayen).
  - canTakeScreenshot (API 30+): screenshot lene ki salahiyat.
  - flagRequestTouchExplorationMode jaan boojh kar NAHI lagaya: wo pure phone
    ki touch ko explore-by-touch mein badal deta (ek tap = focus/bolna, do tap
    = dabana) — user ke aam istemal ke liye nuqsan-deh hai. Hamara control
    dispatchGesture par chalta hai, exploration par nahi.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged|typeViewClicked|typeViewScrolled|typeViewFocused|typeViewTextChanged|typeNotificationStateChanged|typeWindowsChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagRetrieveInteractiveWindows|flagReportViewIds|flagIncludeNotImportantViews"
    android:canPerformGestures="true"
    android:canRetrieveWindowContent="true"
    android:canTakeScreenshot="true"
    android:description="@string/a11y_desc"
    android:notificationTimeout="100" />
